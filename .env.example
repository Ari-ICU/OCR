# ==============================================================================
# KhmerPDF AI - Environment Configuration
# ==============================================================================

# Google Gemini AI Key (Optional if entered directly via Web UI)
GEMINI_API_KEY=

# Hugging Face API Token (Optional for Qwen 72B Vision OCR)
HUGGINGFACE_API_KEY=

# Ollama Endpoint (Default connects to host machine's Ollama instance)
OLLAMA_URL=http://host.docker.internal:11434

# Public API URL for Frontend to connect to Backend
# - Leave empty ("") if using Nginx reverse proxy (recommened for production)
# - Set to http://<SERVER_IP>:8000 if accessing backend port directly without Nginx
# - Default: automatically detects server host in browser
NEXT_PUBLIC_API_URL=

# Port bindings
BACKEND_PORT=8000
FRONTEND_PORT=3000

